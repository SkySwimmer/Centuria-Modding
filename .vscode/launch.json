                "pipeCwd": "${workspaceFolder}/feraltweaks-bootstrap/run",
                "pipeProgram": "bash",
                "pipeArgs": [ "${workspaceFolder}/feraltweaks-bootstrap/run/debug.sh" ],
                "debuggerPath": "vsdbg/vsdbg.exe",
                "quoteArgs": true
            },
            "request": "attach"
        },
