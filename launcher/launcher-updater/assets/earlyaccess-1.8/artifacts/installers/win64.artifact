#!/bin/bash

# Metadata
local arch=win64

# Installer build profile
function build_installer() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # Base win64 artifact
    from-artifact share/win64.artifact

    # Windows launcher
    require-artifact launcher/win64.artifact

    # Copy sources
    from-assets installers/payload-assets/win64
    
    # Installer data
    from-target shareddata common installerdata
    from-assets base/launcher/win64 installerdata
    rm -v installerdata/server.json || exit 1

    # Move files
    mv -v "Centuria Launcher Updater.jar" "Centuria Launcher Installer.jar" || exit 1
    
    # Remove icon files that are not used
    rm -v "icon.ico" || exit 1
    rm -v "icon.png" || exit 1
}

# Self-extracting installer
function build_selfextr() {
    # Copy self-extracting installer
    from-cwd ../windows-self-extracting-installer windows-self-extracting-installer

    # Copy built installer
    from-target installer win64-base installer-data

    # Create folder
    if [ ! -d windows-self-extracting-installer/CenturiaSelfExtractingInstaller/installer ]; then
        mkdir windows-self-extracting-installer/CenturiaSelfExtractingInstaller/installer
    fi

    # Zip target
    (cd installer-data ; zip -r ../windows-self-extracting-installer/CenturiaSelfExtractingInstaller/installer/payload.zip .)

    # Copy icons
    from-assets base/share/common/icon.ico windows-self-extracting-installer/CenturiaSelfExtractingInstaller/installer/installer_icon.ico

    # Build installer
    (cd windows-self-extracting-installer ; msbuild /t:Build /p:Configuration=Release) || exit 1

    # Copy result
    cp -v windows-self-extracting-installer/CenturiaSelfExtractingInstaller/bin/Release/CenturiaSelfExtractingInstaller.exe emuferal-installer-win64.exe
}

# Call builds
# Parameters: <target type> <target name> <profile>
build installer win64-base build_installer
build installer win64-selfextr build_selfextr

# Create artifacts
# Parameters: <mode> <target type> <target name> <target artifact name>
# Modes: compressed-zip, compressed-targz, raw (copy target)
produce-artifact-result compressed-zip installer win64-base emuferal-installer-win64.zip
produce-artifact-result raw installer win64-selfextr emuferal-installer-win64.exe emuferal-installer-win64.exe
