#!/bin/bash

# Metadata
local arch=osx

# Portable build profile
function build_portable() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # OSX launcher
    from-artifact share/osx.artifact

    # OSX portable assets
    from-assets portables/share
    from-assets portables/osx

    # Set permissions
    chmod +x -v "$BUILD_TARGET/launcher.command" || exit 1
    chmod +x -v "$BUILD_TARGET/launcher-logged.command" || exit 1
}

# Call build
# Parameters: <target type> <target name> <profile>
build portable emuferal-launcher-portable-osx build_portable

# Create artifact
# Parameters: <mode> <target type> <target name> <target artifact name>
# Modes: compressed-zip, compressed-targz, raw (copy target)
produce-artifact-result compressed-zip portable emuferal-launcher-portable-osx emuferal-launcher-portable-osx.zip
