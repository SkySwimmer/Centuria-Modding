#!/bin/bash

# Metadata
local arch=win64

# Portable build profile
function build_portable() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # Win64 Launcher
    from-artifact share/win64.artifact
    from-artifact launcher/win64.artifact
}

# Call build
# Parameters: <target type> <target name> <profile>
build portable emuferal-launcher-portable-win64 build_portable

# Create artifact
# Parameters: <mode> <target type> <target name> <target artifact name>
# Modes: compressed-zip, compressed-targz, raw (copy target)
produce-artifact-result compressed-zip portable emuferal-launcher-portable-win64 emuferal-launcher-portable-win64.zip
