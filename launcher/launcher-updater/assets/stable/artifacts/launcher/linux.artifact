#!/bin/bash

# Metadata
local arch=linux

# Launcher data build profile
function build_launcher() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # The from-url call allows downloading specific files as sources
    # Accepts: <mode> <handler mode> <url> <output>
    # Modes: raw, decompress-zip, decompress-targz
    # Output modes: auto (use first directory if possible, otherwise use normal mode), normal (use the result folder directly), firstdir (use the first subdirectory in the result, errors on multiple directories)

    # Linux launcher assets
    from-assets base/launcher/linux

    # Set permissions
    chmod +x -v "$BUILD_TARGET/launcher.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/launcher-logged.sh" || exit 1
}

# Call build
# Parameters: <target type> <target name> <profile>
build launcherdata linux build_launcher
