#!/bin/bash

# Metadata
local arch=linux

# Installer build profile
function build_installer() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # Base linux artifact
    from-artifact share/linux.artifact

    # Linux launcher
    require-artifact launcher/linux.artifact

    # Copy sources
    from-assets installers/payload-assets/linux
    
    # Installer data
    from-target shareddata common installerdata
    from-assets base/launcher/linux installerdata
    rm -v installerdata/server.json || exit 1

    # Set permissions
    chmod +x -v "$BUILD_TARGET/installerdata/launcher.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/installerdata/launcher-logged.sh" || exit 1

    # Move files
    mv -v "Centuria Launcher Updater.jar" "Centuria Launcher Installer.jar" || exit 1
    
    # Remove icon files that are not used
    rm -v "icon.ico" || exit 1
    rm -v "icon.png" || exit 1
}

# Appimage build profile
function build_appimage() {
    # Copy payload
    from-assets installers/archive-assets/linux

    # Copy built installer
    from-target installer linux-base emuferal-installer-linux.AppDir/usr/share/emuferal-installer

    # Copy icon
    from-assets base/share/common/icon.png emuferal-installer-linux.AppDir/emuferal-installer.png

    # Set permissions
    chmod +x -v "$BUILD_TARGET/emuferal-installer-linux.AppDir/AppRun" || exit 1

    # Build appimage
    appimagetool emuferal-installer-linux.AppDir emuferal-installer-linux.AppImage || exit 1
}

# Call builds
# Parameters: <target type> <target name> <profile>
build installer linux-base build_installer
build installer linux-appimage build_appimage

# Create artifacts
# Parameters: <mode> <target type> <target name> <target artifact name>
# Modes: compressed-zip, compressed-targz, raw (copy target)
produce-artifact-result compressed-zip installer linux-base emuferal-installer-linux.zip
produce-artifact-result raw installer linux-appimage emuferal-installer-linux.AppImage emuferal-installer-linux.AppImage
