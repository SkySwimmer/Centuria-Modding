#!/bin/bash

# Metadata
local arch=osx

local wine_version="11.10"
local wine_url="https://github.com/Gcenx/macOS_Wine_builds/releases/download/%v/wine-staging-%v-osx64.tar.xz"

# Installer build profile
function build_installer() {
    # Set sources

    # The from-artifact call allows taking artifact raw targets as sources
    # Accepts: <artifact builder path> <target type> <target name>
    # If no target type and name are specified, all targets are used

    # The from-assets call allows taking files from the assets folders as sources
    # Accepts: <path>

    # Base osx artifact
    from-artifact share/osx.artifact

    # Wine
    from-url decompress-targz auto "${wine_url//%v/$wine_version}" installerdata/syslibs Contents/Resources/wine

    # Copy sources
    from-assets installers/payload-assets/osx
    
    # Installer data
    from-target shareddata common installerdata
    rm -v installerdata/server.json || exit 1

    # Copy system binaries
    if [ -d "installerdata/osx" ]; then rm -rf installerdata/osx ; fi
    cp -rfv osx installerdata/osx

    # Set permissions
    chmod +x -v "$BUILD_TARGET/installerdata/launcher.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/installerdata/launcher-logged.sh" || exit 1

    # Java permissions
    for file in installerdata/$arch/*/bin/*; do
        chmod +x -v "$file" || exit 1
    done

    # Move files
    mv -v "Centuria Launcher Updater.jar" "Centuria Launcher Installer.jar" || exit 1
    
    # Remove icon files that are not used
    rm -v "icon.ico" || exit 1
    rm -v "icon.png" || exit 1

    # Go up
    cd ..

    # Move
    mv osx-installer-bundle osx-installer-bundle-data

    # Create new and re-enter
    mkdir osx-installer-bundle
    cd osx-installer-bundle

    # Copy built installer
    mkdir -p "EmuFeral Online Installer.app/Contents"
    mv -v ../osx-installer-bundle-data "EmuFeral Online Installer.app/Contents/Resources"

    # Move installer payload
    mv -v "EmuFeral Online Installer.app/Contents/Resources/installerdata" "EmuFeral Online Installer.app/Contents/Resources/payload-installerdata" || exit 1

    # Copy app bundle payload
    from-assets installers/archive-assets/osx

    # Copy payload back
    cp -rfv "EmuFeral Online Installer.app/Contents/Resources/payload-installerdata/." "EmuFeral Online Installer.app/Contents/Resources/installerdata/Contents/Resources" || exit 1
    rm -rfv "EmuFeral Online Installer.app/Contents/Resources/payload-installerdata"
    
    # Set permissions
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/MacOS/EmuFeral Online Installer" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/launcher.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/script" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/installerdata/Contents/MacOS/EmuFeral Online Launcher" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/installerdata/Contents/Resources/launcher.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/installerdata/Contents/Resources/launcher-logged.sh" || exit 1
    chmod +x -v "$BUILD_TARGET/EmuFeral Online Installer.app/Contents/Resources/installerdata/Contents/Resources/script" || exit 1
}

# Call builds
# Parameters: <target type> <target name> <profile>
build installer osx-installer-bundle build_installer

# Create artifacts
# Parameters: <mode> <target type> <target name> <target artifact name>
# Modes: compressed-zip, compressed-targz, raw (copy target)
produce-artifact-result compressed-zip installer osx-installer-bundle emuferal-installer-osx.zip
